class SharedBuffer {
    private int data;
    private boolean hasData = false;
    
    // Producer deposits data
    synchronized void produce(int val) throws InterruptedException {
        while(hasData) wait(); // wait agar buffer full hai
        data = val;
        hasData = true;
        System.out.println("Produced: " + val);
        notify(); // consumer ko jagao
    }
    
    // Consumer takes data
    synchronized int consume() throws InterruptedException {
        while(!hasData) wait(); // wait agar buffer empty hai
        hasData = false;
        System.out.println("Consumed: " + data);
        notify(); // producer ko jagao
        return data;
