import java.util.*;
class doc {
  Vector<String> v;
  doc(Vector<String> vec){
    v=vec;
  }
  synchronized void oddprint(){
    for(int i=1;i<=3;i++){
       
      if(i%2!=0){
        String output="ODD";
        String thread=Thread.currentThread().getName()+" -"+output;
        System.out.println(thread);
        v.add(thread);
        Thread.sleep(new Random.nextInt(2)*1000);
     
      }
    }
  }
  synchronized void evenprint(){
    for(int i=1;i<=3;i++){
      if(i%2==0){
        String output="Even";
        String thread=Thread.currentThread().getName()+" -"+output;
        System.out.println(thread);
        v.add(thread);
        Thread.sleep(new Random.nextInt(2)*1000);
      }
    }
  }


}
class even implements Runnable{
  doc d;
  even(doc de){
    d=de;
  }
  public void run(){
    d.evenprint();
  }
}
class odd implements Runnable{
  doc d;
  odd(doc de){
    d=de;
  }
  public void run(){
    d.oddprint();
  }
}
class Main{
  public static void main(String[] args) {
      Vector <String> v=new Vector<>();
      doc d=new doc(v);
      even e =new even(d);
      odd o=new odd(d);
      Thread t1 = new Thread("thread-1");
      Thread t2 = new Thread("thread-2");
      Thread t3 = new Thread("thread-3");
      t1.start();
      t2.start();
      t3.start();
  }
}



